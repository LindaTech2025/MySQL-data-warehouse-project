/*
==========================================================================
== Create Database and Schemas 
==========================================================================

== This script creates a database naned'Datawarehouse' as well as three schemas in the database (bronze, silver and gold).
*/

== Create the database and name it ‘DataWarehouse’ 


CREATE DATABASE Datawarehouse;

USE DataWarehouse;


== Create Schemas 

CREATE SCHEMA bronze;
GO 
CREATE SCHEMA silver;
GO
CREATE SCHEMA gold;
GO
